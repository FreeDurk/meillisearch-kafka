{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/meilisearch_kafka/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/meilisearch_kafka/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/meilisearch_kafka",
  "projects": {
    "api": {
      "type": "application",
      "root": "apps/api",
      "entryFile": "main",
      "sourceRoot": "apps/api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api/tsconfig.app.json"
      }
    },
    "meili_indexing": {
      "type": "application",
      "root": "apps/meili_indexing",
      "entryFile": "main",
      "sourceRoot": "apps/meili_indexing/src",
      "compilerOptions": {
        "tsConfigPath": "apps/meili_indexing/tsconfig.app.json"
      }
    },
    "meilisearch_kafka": {
      "type": "application",
      "root": "apps/meilisearch_kafka",
      "entryFile": "main",
      "sourceRoot": "apps/meilisearch_kafka/src",
      "compilerOptions": {
        "tsConfigPath": "apps/meilisearch_kafka/tsconfig.app.json"
      }
    },
    "movie": {
      "type": "application",
      "root": "apps/movie",
      "entryFile": "main",
      "sourceRoot": "apps/movie/src",
      "compilerOptions": {
        "tsConfigPath": "apps/movie/tsconfig.app.json"
      }
    }
  }
}